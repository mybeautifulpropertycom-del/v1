{
  "name": "my-beautiful-property",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:vercel": "node scripts/check-deployment-env.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:connected": "playwright test --config playwright.connected.config.ts",
    "supabase:prepare-sql": "node scripts/prepare-supabase-sql.mjs",
    "supabase:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@higgsfield/client": "^0.2.6",
    "@stripe/stripe-js": "^10.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
