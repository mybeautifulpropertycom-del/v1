# Public Supabase configuration. Never use a service_role key in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set only after the domain points to your deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional photo-based property writing. SERVER ONLY: never prefix with NEXT_PUBLIC_.
# Requires the additive property-stories migration and separate OpenAI API billing.
OPENAI_API_KEY=
OPENAI_PROPERTY_MODEL=gpt-4.1-mini

# Stripe embedded Checkout. Public browser key; Vercel Config is appropriate.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The following payment credentials are SERVER ONLY.
# Mode: test or live; leave unset to hide checkout. Match keys/webhook to the mode.
STRIPE_CHECKOUT_MODE=
# Prepare live with false. Set true only after video fulfilment is ready.
STRIPE_LIVE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Supabase legacy service_role key (or server secret key), never the public key.
SUPABASE_SERVICE_ROLE_KEY=

# Higgsfield Cloud API credentials. SERVER ONLY; use Secret in Vercel.
# Paste the entire single key from the current dashboard into HF_KEY.
HF_KEY=
# Older accounts may use the following key/secret pair instead.
# Keep disabled until credentials, model configuration, migration and scheduler are ready.
HF_API_KEY=
HF_API_SECRET=

# Alternative credential format: KEY_ID:KEY_SECRET. Do not set multiple formats.
HF_CREDENTIALS=
# Explicit opt-in to billable generation; no paid requests while false.
HIGGSFIELD_ENABLED=false
# Multi-photo Higgsfield/Minimax film (uses API credits): higgsfield-montage.
# Original-photo animation (no Hailuo generations): photo-montage.
# Leave empty for the existing single-clip Higgsfield flow. New jobs only.
PROPERTY_VIDEO_MODE=
# Optional trusted absolute FFmpeg path for local development on non-Linux hosts.
PROPERTY_FILM_FFMPEG=
# A key from config/higgsfield-models.json or HIGGSFIELD_MODELS_JSON. No default model.
# Hailuo: hailuo-2.3-standard (6 seconds per selected photo in higgsfield-montage).
HIGGSFIELD_MODEL=
# Optional JSON model registry; overrides file presets by key. Non-secret Config.
HIGGSFIELD_MODELS_JSON=
# Random server secret, at least 32 characters. Also installed in scheduler Vault.
CRON_SECRET=

# New lead emails via Resend. Server-only Secret; sender domain must be verified.
# Supabase Auth SMTP configuration does not enable application notification emails.
RESEND_API_KEY=
