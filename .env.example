# Public Supabase configuration. Never use a service_role key in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set only after the domain points to your deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional photo-based property writing. SERVER ONLY: never prefix with NEXT_PUBLIC_.
# Requires the additive property-stories migration and separate OpenAI API billing.
OPENAI_API_KEY=
OPENAI_PROPERTY_MODEL=gpt-4.1-mini

# Stripe hosted Checkout. SERVER ONLY; never use NEXT_PUBLIC_ prefixes.
# Mode: test or live; leave unset to hide checkout. Match keys/webhook to the mode.
STRIPE_CHECKOUT_MODE=
# Prepare live with false. Set true only after video fulfilment is ready.
STRIPE_LIVE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Supabase legacy service_role key (or server secret key), never the public key.
SUPABASE_SERVICE_ROLE_KEY=
